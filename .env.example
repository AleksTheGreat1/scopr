# Used EXCLUSIVELY to sign and verify JWT tokens.
# Must be a strong, random string (minimum 32 characters for HS256).
SCOPR_SECRET_KEY="replace_me_with_a_long_random_string"

# Used to authorize token minting and revocation endpoints.
# Pass this in the X-Admin-Key header, or via the SDK initialization.
SCOPR_ADMIN_KEY="replace_me_with_a_secure_admin_password"
